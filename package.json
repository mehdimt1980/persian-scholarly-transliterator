{
  "name": "persian-scholarly-transliterator",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:corpus": "tsx src/validation/cli.ts",
    "validate:acquisition": "tsx src/validation/acquisition/cli.ts",
    "acquisition:review-sheet": "tsx src/validation/acquisition/cli.ts --export-sheet",
    "validate:adjudication": "tsx src/validation/review/cli.ts",
    "validate:reaudit-worklist": "tsx src/validation/review/reauditWorklistCli.ts",
    "build:v2-benchmark": "tsx src/validation/review/consolidateV2BenchmarkCli.ts --write",
    "validate:v2-benchmark": "tsx src/validation/review/consolidateV2BenchmarkCli.ts",
    "validate:gold-freeze": "tsx src/validation/review/goldFreezeV2Cli.ts",
    "evaluate:v2-frozen": "tsx src/validation/v2/phase46CBaselineCli.ts",
    "validate:v2-regression": "tsx src/validation/v2/frozenRegressionCli.ts",
    "validate:portability": "tsx src/validation/release/releasePortabilityCli.ts",
    "evidence:loc:pilot": "tsx src/domain/evidence/loc/cli.ts",
    "evidence:alignment:pilot": "tsx src/domain/evidence/alignment/cli.ts",
    "evidence:scheme:pilot": "tsx src/domain/evidence/scheme/cli.ts",
    "evidence:adjudication:pilot": "tsx src/domain/evidence/adjudication/cli.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "openai": "^4.104.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.86.0",
    "tsx": "^4.23.15",
    "typescript": "5.6.2",
    "vitest": "4.1.11"
  }
}
